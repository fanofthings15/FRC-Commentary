{
  "name": "frc-commentary",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "bun run ./scripts/dev.ts",
    "dev:backend": "cd backend && bun run dev",
    "dev:frontend": "cd frontend && bun run dev",
    "build:ui": "cd frontend && bun run build",
    "build:exe": "bun run build:ui && bun run ./scripts/zip-ui.ts && bun build --compile --target=bun-windows-x64 ./backend/src/index.ts --outfile app.exe"
  },
  "devDependencies": {
    "fflate": "^0.8.2"
  }
}
